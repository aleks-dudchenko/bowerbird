{
  "manifest_version": 3,
  "name": "Save to Zbirka",
  "version": "0.1.0",
  "description": "Right-click any image or video and save it into your local Zbirka library. Talks only to the app on your own machine.",
  "permissions": [
    "contextMenus",
    "storage",
    "notifications"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  }
}
